# AI Study Planner — Docker Deployment Environment Variables
# Copy this file to .env and fill in your values

# Required: OpenAI API key for AI study plan generation
OPENAI_API_KEY=sk-your-openai-api-key

# Optional: Custom OpenAI model (default: gpt-5.5)
# GPT-5.5 is the API id for the Fast GPT-5.5 model.
# OPENAI_MODEL=gpt-5.5

# Optional: Lower reasoning effort improves latency for plan generation.
# OPENAI_REASONING_EFFORT=low
# OPENAI_MAX_OUTPUT_TOKENS=32000

# Optional: Write last AI prompt/response JSON to /tmp for debugging. Disabled by default.
# AI_PLANNER_DEBUG_DUMP=false

# Required: JWT secret for user session tokens
JWT_SECRET=your-jwt-secret-change-in-production

# Backend database (Docker handles this automatically)
# DATABASE_URL=postgres://postgres:postgres@postgres:5432/studyplanner

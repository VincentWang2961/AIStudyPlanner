generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model course_groups {
  id          BigInt        @id @default(autoincrement())
  course_code String
  group_code  String
  name        String
  rule_text   String?
  rule_json   Json?
  courses     courses       @relation(fields: [course_code], references: [code], onDelete: Cascade, onUpdate: NoAction)
  group_units group_units[]

  @@unique([course_code, group_code])
}

model course_units {
  course_code String
  unit_code   String
  courses     courses @relation(fields: [course_code], references: [code], onDelete: Cascade, onUpdate: NoAction)
  units       units   @relation(fields: [unit_code], references: [code], onDelete: Cascade, onUpdate: NoAction)

  @@id([course_code, unit_code])
}

model courses {
  code             String          @id
  title            String
  major_code       String?
  min_points       Int?
  max_points       Int?
  time_limit_years Int?
  specialisations  Json?           @default("[]")
  extracted_rules  Json?           @default("[]")
  course_groups    course_groups[]
  course_units     course_units[]
}

model group_units {
  group_id      BigInt
  unit_code     String
  course_groups course_groups @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  units         units         @relation(fields: [unit_code], references: [code], onDelete: Cascade, onUpdate: NoAction)

  @@id([group_id, unit_code])
}

model units {
  code                     String         @id
  title                    String
  curriculum_type          String?
  source_id                String?
  status                   String?
  availabilities           String?
  description              String?
  prerequisites_raw        String?
  prerequisites_parsed     Json?
  corequisites_raw         String?
  corequisites_parsed      Json?
  incompatibilities_raw    String?
  incompatibilities_parsed Json?
  course_units             course_units[]
  group_units              group_units[]
}

model users {
  id            BigInt          @id @default(autoincrement())
  email         String          @unique
  password_hash String
  password_salt String
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  updated_at    DateTime        @updatedAt @db.Timestamptz(6)
  study_plans   study_plans[]
  user_sessions user_sessions[]
}

model user_sessions {
  id         BigInt   @id @default(autoincrement())
  user_id    BigInt
  token_hash String   @unique
  expires_at DateTime @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id])
  @@index([expires_at])
}

model guest_sessions {
  id          BigInt        @id @default(autoincrement())
  token_hash  String        @unique
  created_at  DateTime      @default(now()) @db.Timestamptz(6)
  last_seen_at DateTime     @default(now()) @db.Timestamptz(6)
  study_plans study_plans[]
}

model study_plans {
  id          BigInt          @id @default(autoincrement())
  user_id     BigInt?
  guest_id    BigInt?
  name        String
  course_code String?
  program     String?
  config      Json?
  plan_data   Json
  created_at  DateTime        @default(now()) @db.Timestamptz(6)
  updated_at  DateTime        @updatedAt @db.Timestamptz(6)
  guests      guest_sessions? @relation(fields: [guest_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users       users?          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id])
  @@index([guest_id])
  @@index([updated_at])
}

model token_usage {
  date          String @id
  tokens_used   BigInt @default(0)
  request_count Int    @default(0)
}

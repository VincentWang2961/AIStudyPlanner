# Backend Environment Variables
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5433/studyplanner

# Server
PORT=3001
FRONTEND_ORIGIN=http://localhost:3000

# Authentication
JWT_SECRET=your_jwt_secret

# AI / LLM
# OpenAI API key (set this or LLM_API_KEY)
OPENAI_API_KEY=sk-your-openai-api-key
# Alternative env var name (set this or OPENAI_API_KEY)
LLM_API_KEY=
# Model to use (default: gpt-4o)
OPENAI_MODEL=gpt-4o

# Scraping
SCRAPER_INTERVAL=3600

# Optional: Email (not currently used)
EMAIL_SERVICE=
EMAIL_USER=
EMAIL_PASS=

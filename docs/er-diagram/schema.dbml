Table users {
  id bigint [pk, increment]
  email varchar [unique, not null]
  name varchar
  course_code varchar [ref: > courses.code]
  specialisation_code varchar
  start_year int
  start_semester varchar // S1, S2
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table plan_preferences {
  id bigint [pk, increment]
  user_id bigint [not null, unique, ref: > users.id]
  finish_as_soon_as_possible boolean [not null, default: false]
  prefer_balanced_workload boolean [not null, default: false]
  allow_part_time boolean [not null, default: false]
  preferred_max_units_per_semester int
  notes text
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table courses {
  code varchar [pk] // e.g. MIT
  title varchar [not null]
  major_code varchar
  min_points int
  max_points int
  time_limit_years int
  specialisations jsonb [default: '[]']
  extracted_rules jsonb [default: '[]']
}

Table units {
  code varchar [pk] // e.g. CITS1401
  title varchar [not null]
  curriculum_type varchar
  source_id varchar
  status varchar
  availabilities varchar
  prerequisites_raw text
  prerequisites_parsed jsonb
  corequisites_raw text
  corequisites_parsed jsonb
  incompatibilities_raw text
  incompatibilities_parsed jsonb
}

Table course_units {
  course_code varchar [not null, ref: > courses.code]
  unit_code varchar [not null, ref: > units.code]

  Indexes {
    (course_code, unit_code) [pk]
  }
}

Table course_groups {
  id bigint [pk, increment]
  course_code varchar [not null, ref: > courses.code]
  group_code varchar [not null]
  name varchar [not null]
  rule_text text
  rule_json jsonb

  Indexes {
    (course_code, group_code) [unique]
  }
}

Table group_units {
  group_id bigint [not null, ref: > course_groups.id]
  unit_code varchar [not null, ref: > units.code]

  Indexes {
    (group_id, unit_code) [pk]
  }
}

Table specialisations {
  course_code varchar [not null, ref: > courses.code]
  code varchar [not null]
  name varchar [not null]
  created_at timestamp
  updated_at timestamp

  Indexes {
    (course_code, code) [pk]
  }
}

Table unit_offerings {
  id bigint [pk, increment]
  unit_code varchar [not null, ref: > units.code]
  academic_year int
  semester varchar [not null] // S1, S2, Summer
  campus varchar
  teaching_mode varchar
  is_available boolean [not null, default: true]
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table course_requirements {
  id bigint [pk, increment]
  course_code varchar [not null, ref: > courses.code]
  specialisation_code varchar
  unit_code varchar [not null, ref: > units.code]
  requirement_type varchar [not null] // core, specialisation_core, elective, option
  recommended_year int
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table unit_prerequisites {
  id bigint [pk, increment]
  unit_code varchar [not null, ref: > units.code]
  prerequisite_unit_code varchar [not null, ref: > units.code]
  created_at timestamp [not null]

  Indexes {
    (unit_code, prerequisite_unit_code) [unique]
  }
}

Table unit_corequisites {
  id bigint [pk, increment]
  unit_code varchar [not null, ref: > units.code]
  corequisite_unit_code varchar [not null, ref: > units.code]
  created_at timestamp [not null]

  Indexes {
    (unit_code, corequisite_unit_code) [unique]
  }
}

Table unit_incompatibilities {
  id bigint [pk, increment]
  unit_code varchar [not null, ref: > units.code]
  incompatible_unit_code varchar [not null, ref: > units.code]
  created_at timestamp [not null]

  Indexes {
    (unit_code, incompatible_unit_code) [unique]
  }
}

Table user_completed_units {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  unit_code varchar [not null, ref: > units.code]
  completion_year int
  completion_semester varchar
  grade varchar
  created_at timestamp [not null]

  Indexes {
    (user_id, unit_code) [unique]
  }
}

Table study_plans {
  id bigint [pk, increment]
  user_id bigint [ref: > users.id]
  course_code varchar [not null, ref: > courses.code]
  specialisation_code varchar
  title varchar
  start_year int [not null]
  start_semester varchar [not null] // S1, S2
  max_units_per_semester int [not null]
  status varchar [not null, default: 'draft'] // draft, active, archived
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table study_plan_semesters {
  id bigint [pk, increment]
  study_plan_id bigint [not null, ref: > study_plans.id]
  sequence_no int [not null]
  year int [not null]
  semester varchar [not null] // S1, S2, Summer
  created_at timestamp [not null]
  updated_at timestamp [not null]

  Indexes {
    (study_plan_id, sequence_no) [unique]
  }
}

Table study_plan_units {
  id bigint [pk, increment]
  study_plan_semester_id bigint [not null, ref: > study_plan_semesters.id]
  unit_code varchar [not null, ref: > units.code]
  source varchar [not null, default: 'auto'] // auto, manual
  placement_status varchar [not null, default: 'pending'] // pending, valid, invalid, warning
  created_at timestamp [not null]
  updated_at timestamp [not null]

  Indexes {
    (study_plan_semester_id, unit_code) [unique]
  }
}